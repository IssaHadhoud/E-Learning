@model E_learning.ViewModel.CourseViewModel
@{ ViewData["Title"] = "Create course"; }
<div class="row justify-content-center"><div class="col-lg-8"><span class="eyebrow">INSTRUCTOR STUDIO</span><h1 class="section-title mb-2">Create a course</h1><p class="text-secondary mb-4">Start with a clear title and a concise overview. You can add lessons as your curriculum takes shape.</p>
    <form asp-action="Create" method="post" enctype="multipart/form-data" class="p-4 p-md-5 border rounded-4 bg-white shadow-sm">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="mb-3"><label asp-for="Title" class="form-label">Course title</label><input asp-for="Title" class="form-control"/><span asp-validation-for="Title" class="text-danger"></span></div>
        <div class="mb-4"><label asp-for="Details" class="form-label">Course description</label><textarea asp-for="Details" class="form-control" rows="6"></textarea><span asp-validation-for="Details" class="text-danger"></span></div>
        <h2 class="h5 mb-3">Course materials <span class="text-secondary fw-normal">(optional)</span></h2>
        <div class="mb-3"><label asp-for="Image" class="form-label">Cover image · JPG, PNG, WebP · up to 100 MB</label><input asp-for="Image" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control"/></div>
        <div class="mb-3"><label asp-for="Video" class="form-label">Preview video · MP4, WebM · up to 100 MB</label><input asp-for="Video" type="file" accept=".mp4,.webm" class="form-control"/></div>
        <div class="mb-3"><label asp-for="Document" class="form-label">Course document · PDF · up to 100 MB</label><input asp-for="Document" type="file" accept=".pdf" class="form-control"/></div>
        <div class="mb-4"><label asp-for="Assignment" class="form-label">Assignment guide · PDF · up to 100 MB</label><input asp-for="Assignment" type="file" accept=".pdf" class="form-control"/></div>
        <div class="d-flex justify-content-end gap-2"><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a><button class="btn btn-primary" type="submit">Save draft</button></div>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
