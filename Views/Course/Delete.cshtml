@model Courses

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}
<h1 class="link-danger">Delete</h1>
<h3 class="link-dark">Are you sure you want to delete this "@Model.Title"?</h3>
<div >
    <del class="container">
        <dt class="box-shadow">
            <img asp-route-id="@Model.Id"><img src="~/@Model.ImageURL"></img>
        </dt>
        <dt>
            <a>@Model.Title</a>
        </dt>
        <dt >
            <a>@Model.Details</a>
        </dt>
        @* <dt > *@
        @*     @Html.DisplayNameFor(model => model.VideoURL) *@
        @* </dt> *@
        @* <dt > *@
        @*     @Html.DisplayNameFor(model => model.Documents) *@
        @* </dt> *@
        <form asp-action="Delete">
            @using (Html.BeginForm("Delete", "Course", new { id = Model.Id }, FormMethod.Post))
            {
                <button type="submit" value="Delete" class="btn-btn-danger">Delete</button>
            }
            <a asp-action="Index" class="btn-btn-outline-danger">Back</a>
        </form>
    </del>
</div>