@model E_learning.Models.Courses

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}
<style>
body{
    box-sizing: border-box;
}

    .container {
    padding: 20px;
    max-width: 900px;
    margin: 5% 0;;
}

.container-fluid {
    display: flex;
    flex-direction: column;
    align-items: center;
}

/* Course details section */
.Course-details {
    background-color: #f9f9f9;
    border-radius: 10px;
    padding: 20px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    text-align: center;
    margin-bottom: 20px;
}

/* Course image styling */
.Course-Image img {
    border-radius: 50%;
    border: auto;
    margin-bottom: 20px;
}

/* Course details text */
.Course-details p {
    font-size: 1.1rem;
    color: #333;
    margin-bottom: 20px;
}

/* Course video styling */
.Course-Video video {
    border: 1px solid #ddd;
    border-radius: 10px;
    margin-bottom: 20px;
}

/* Document button styling */
.Document button {
    margin-bottom: 20px;
}

.Document a {
    color: #fff;
    text-decoration: none;
}

.Document a:hover {
    text-decoration: underline;
}

/* Button styling */
.btn {
    padding: 10px 20px;
    font-size: 1rem;
    border-radius: 5px;
}

.btn-outline-danger {
    color: #dc3545;
    border: 1px solid #dc3545;
    background-color: transparent;
    transition: background-color 0.3s, color 0.3s;
}

.btn-outline-danger:hover {
    background-color: #dc3545;
    color: white;
}

.btn-outline-primary {
    color: #007bff;
    border: 1px solid #007bff;
    background-color: transparent;
    transition: background-color 0.3s, color 0.3s;
}

.btn-outline-primary:hover {
    background-color: #007bff;
    color: white;
}

    
</style>
<body>
<h2>Course Details</h2>
<div class="container">
    <div class="container-fluid">
        <div class="Course-details">
            <div class="Course-Image">
                <center><img src="~/@Model.ImageURL" alt="Course Image" height="250" width="250" ></center> 
            </div>
            <div class="container-fluid">
                <center><a>@Model.Details</a></center>
            </div>
            <div class="Course-Video">
               <center><video src="~/@Model.VideoURL" /></center> 
            </div>
            <div class="Document">
               <button class="btn btn-primary"><a href="~/@Model.Documents" download > Download Document</a> </button>
            </div>
        </div>
        <a asp-action="Delete" asp-route-ID="@Model.Id" class="btn-btn-outline-danger">Delete</a>
        <a asp-action="Edit" asp-route-ID="@Model.Id" class="btn-btn-outline-primary">Edit</a>
    </div>
</div>
</body>