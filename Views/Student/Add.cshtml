@model E_learning.ViewModel.StudentViewModel

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}
<h2>Add</h2>
<div class="container">
    <div class="card-group">
        <form asp-action="Add" method="post" enctype="multipart/form-data">
            <div class="card-group">
                <label for="FirstName">First Name:</label>
                <input type="text" id="FirstName" name="FirstName"></input>
            </div>
            <div class="card-group">
                <label for="LastName">Last Name: </label>
                <input type="text" id="LastName" name="LastName"></input>
            </div>
            <div class="card-group">
                <label for="Address">Address :</label>
                <input type="text" id="Address" name="Address"></input>
            </div>
            <div class="card-group">
                <label for="BirthOfDate"> Birth Of Date</label>
                <input type="Date" id="BirthOfDate" name="BirthOfDate"></input>
            </div>
            <div class="card-group">
                <label for="Department">Department :</label>
                <input type="text" id="Department" name="Department"/>
            </div>
            <div class="card-group">
                <label for="Number"> Phone Number:</label>
                <input type="number" id="Number" name="Number"></input>
            </div>
            <input type="submit" value="Subomt"></input>
        </form> 
    </div>
</div>
 