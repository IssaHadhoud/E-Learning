@model E_learning.ViewModel.RegisterViewModel
@{ ViewData["Title"] = "Create your account"; }
<section class="auth-shell">
    <div class="auth-card auth-card-wide">
        <div class="auth-intro"><span class="eyebrow">YOUR NEXT CHAPTER</span><h1>Learn something that moves you forward.</h1><p>Create a learner account to explore courses and save your progress.</p></div>
        <form asp-action="Register" method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="row g-3">
                <div class="col-sm-6"><label asp-for="FirstName" class="form-label">First name</label><input asp-for="FirstName" class="form-control" autocomplete="given-name"/><span asp-validation-for="FirstName" class="text-danger"></span></div>
                <div class="col-sm-6"><label asp-for="LastName" class="form-label">Last name</label><input asp-for="LastName" class="form-control" autocomplete="family-name"/><span asp-validation-for="LastName" class="text-danger"></span></div>
                <div class="col-12"><label asp-for="Email" class="form-label">Email address</label><input asp-for="Email" class="form-control" autocomplete="email"/><span asp-validation-for="Email" class="text-danger"></span></div>
                <div class="col-sm-6"><label asp-for="Password" class="form-label">Password</label><input asp-for="Password" class="form-control" autocomplete="new-password"/><span asp-validation-for="Password" class="text-danger"></span></div>
                <div class="col-sm-6"><label asp-for="ConfirmPassword" class="form-label">Confirm password</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password"/><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
                <div class="col-12"><label asp-for="Department" class="form-label">Area of interest <span class="text-secondary">(optional)</span></label><input asp-for="Department" class="form-control"/></div>
            </div>
            <button class="btn btn-primary btn-lg w-100 mt-4" type="submit">Create learner account</button>
            <p class="mt-4 mb-0 text-center text-secondary">Already a member? <a asp-action="Login">Sign in</a></p>
        </form>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
