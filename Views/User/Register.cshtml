@model E_learning.ViewModel.RegisterViewModel

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}
<style>
		* {
			box-sizing: border-box;
		}
		body {
			font-family: Arial, sans-serif;
			background-color: #f4f4f4;
		}
		.container {
			display: flex;
			justify-content: center;
			align-items: center;
			height: 100vh;
		}
		.form-container {
			background-color: #fff;
			border-radius: 10px;
			box-shadow: 0px 0px 10px #ccc;
			display: flex;
			flex-direction: row;
			width: 80%;
			max-width: 1000px;
			height: 80%;
			max-height: 600px;
			overflow: hidden;
		}
		.left-side {
			background-color: #333;
			color: #fff;
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			width: 50%;
			padding: 50px;
		}
		.right-side {
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			width: 50%;
			padding: 50px;
		}
		h1 {
			margin-top: 0;
			margin-bottom: 30px;
		}
		input[type=text], input[type=email], input[type=password] {
			padding: 10px;
			margin-bottom: 20px;
			border-radius: 5px;
			border: none;
			background-color: #f4f4f4;
			font-size: 16px;
			width: 100%;
		}
		input[type=submit] {
			background-color: #333;
			color: #fff;
			border: none;
			border-radius: 5px;
			padding: 10px 20px;
			font-size: 16px;
			cursor: pointer;
		}
		input[type=submit]:hover {
			background-color: #555;
		}
	</style>
<h2>Register</h2>
<div class="container-md">
    <div class="form-container">
        <div class="left-side">
            <h3>Welcome back</h3>
            <h4>Please enter the folowing forms to register in this webside </h4>
        </div>
        <div class="right-side">
            <form asp-action="Register" method="post" enctype="multipart/form-data">
                <label for="Email">Email : </label>
                <input type="text" id="Email" name="Email"></input>
                <label for="Password"> Password :</label>
                <input type="password" id="Password" name="Password"></input>
                <label for="ConfirmPassword"> Confirm Password :</label>
                <input type="password" id="ConfirmPassword" name="ConfirmPassword"></input>
                <label for="FirstName">First Name:</label>
                <input type="text" id="FirstName" name="FirstName"></input>
                <label for="LastName">Last Name:</label>
                <input type="text" id="LastName" name="LastName"/>
                <label for="Department">Department :</label>
                <input type="text" id="Department" name="Department"/>
                @* <select name="Department" id="Department" form="Conform"> *@
                @*     <option value="MIS">MIS :</option> *@
                @*     <option value="Accounting">Accounting :</option> *@
                @*     <option value="Business Manager">Business Manager :</option> *@
                @* </select> *@
                <input type="submit" value="Create Account"/>

            </form>
            @* <button asp-action="Login" class="btn-btn-primary"> Login</button> *@
        </div>
    </div>
</div>